<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Game Icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_game_car"
        android:contentDescription="Game icon" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/game_title"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.1" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/game_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:fontFamily="sans-serif-light" />

    <!-- High Score -->
    <TextView
        android:id="@+id/highScoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="@color/warning_amber"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Play Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/playButton"
        android:layout_width="220dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:text="@string/play_button"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="@color/safe_green"
        android:textColor="@color/text_primary" />

    <!-- How to Play -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/howToPlayButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="@string/how_to_play_title"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:strokeColor="@color/text_secondary" />

</LinearLayout>
